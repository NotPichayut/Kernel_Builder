# ZRAM compression algorithm configuration fragment.
# Appended to defconfig by the build.yml workflow when use_zram is enabled.
# CRYPTO_* is required by the crypto-interface ZRAM implementation in 5.10–6.6;
# ZRAM_BACKEND_* is required by the new ZRAM architecture in 6.12 (direct backend_* implementation).
# These symbols are declared in Kconfig only for 6.12+; build.yml removes them for earlier versions.
# (bazel kernel_config validation requires fragment options to exist in Kconfig.)
CONFIG_CRYPTO_LZ4HC=y
CONFIG_CRYPTO_LZ4K=y
CONFIG_CRYPTO_LZ4KD=y
CONFIG_CRYPTO_842=y
CONFIG_CRYPTO_LZ4K_OPLUS=y
CONFIG_ZRAM_BACKEND_LZ4K=y
CONFIG_ZRAM_BACKEND_LZ4KD=y
CONFIG_ZRAM_BACKEND_LZ4K_OPLUS=y
