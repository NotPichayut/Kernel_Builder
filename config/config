# ==================== Custom Commit Configuration ====================
# This file configures custom commits for the SUSFS and SukiSU repositories.
#
# Usage:
#   1. Set custom to true to enable custom commits.
#   2. Enter the desired commit hash after the corresponding configuration option.
#   3. Leave blank to use the latest commit on that branch.
#
# Example:
#   gki-android14-6.1=abc123def456
#   sukisu=def789abc123
#
# ================================================================

# Enable custom commits (true/false)
custom=false

# ==================== SUSFS Commit Hashes by Branch ====================
# Applies only when custom=true.
gki-android12-5.10=
gki-android13-5.15=
gki-android14-6.1=
gki-android15-6.6=
gki-android16-6.12=

# ==================== SukiSU Commit Hash ====================
# Applies only when custom=true and using the SukiSU variant.
sukisu=
